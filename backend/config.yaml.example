# 编译平台配置文件（模板）
# 复制为 config.yaml 后按需修改。setup.sh install 会自动从本模板复制（不存在 config.yaml 时）。
# 重要：本文件不含真实密码 — 部署时手动编辑或保持默认（默认即开发/测试用账号）

# ===== 数据库 =====
database:
  type: postgresql  # postgresql | sqlite（生产用 postgresql）
  # PostgreSQL 配置
  postgresql:
    host: localhost
    port: 5432
    username: compile_user
    password: compile123
    database: compile_platform
  # SQLite 配置（仅当 type: sqlite 时生效）
  sqlite:
    path: ./cache/compile_platform.db

# ===== JWT =====
jwt:
  # secret_key 生产环境必须改成强随机字符串（用 `python3 -c "import secrets; print(secrets.token_urlsafe(48))"` 生成）
  secret_key: "loongarch-compile-platform-secret-CHANGE-ME-IN-PROD"
  algorithm: HS256
  expire_minutes: 1440  # 24 小时

# ===== 编译引擎 =====
compile:
  timeout: 3600        # 编译超时（秒）
  max_concurrent: 10   # 最大并发任务数
  artifact_dir: ./artifacts  # 相对路径会回退到仓库根 /artifacts（不填绝对路径也行）

# ===== 阶段5 / 单条 docker exec 超时 =====
# 这些默认即可；可在 .env.compile 里用同名 env 覆盖
stage5:
  max_seconds: 1800    # 整个 stage5 阶段硬上限（秒）
  loop_threshold: 5    # 死循环检测：连续快速失败次数
  loop_window: 5       # 死循环检测：单次失败间隔窗口（秒）
docker_exec:
  timeout: 3600        # 单条 docker exec 命令 timeout（秒）

# ===== 文件上传 =====
upload:
  max_size: 2147483648  # 2GB