# 编译平台环境变量（复制为 .env.compile 填真值；本文件入 git，.env.compile 不入）
# 优先级：本文件(env) > config.yaml > 代码默认。密钥/机器相关量放这里，运维参数归 config.yaml。

# AI 服务（必填）
export AI_MODEL=""        # 模型名
export AI_BASE_URL=""     # OpenAI 兼容网关
export AI_API_KEY=""      # 密钥

# ADMIN_INIT_PASSWORD: setup.sh init/install 首建管理员的密码（≥8 位，非交互终端必传）
# export ADMIN_INIT_PASSWORD="<your-strong-password>"
# export ADMIN_INIT_USERNAME="admin"    # 可选，默认 admin

# 可选覆盖（留注释 = 用 config.yaml 值；键名 = 段.键 大写、点转下划线）
# export STAGE5_MAX_SECONDS="10800"
# export DOCKER_EXEC_TIMEOUT="3600"
# export MAX_WORKERS="8"
# export ALLOW_SELF_REGISTER="1"
# JWT 签名密钥（必填，缺失拒绝启动；C1 轮换 2026-10-26）
export JWT_SECRET_KEY=""    # openssl rand -hex 32 生成

# PostgreSQL 口令（必填，缺失拒绝启动；T-9 轮换 2026-10-26，rotate-db-password 生成）
export DB_PASSWORD=""
