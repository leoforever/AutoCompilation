# 编译 worker / engine 所需的环境变量
# 这是模板文件，提交到 git。
# 实际配置请复制为 .env.compile 并填入真实值，.env.compile 不提交。

# ====== AI 配置 ======
# DeepAgent 调用的 LLM 配置
export AI_MODEL=""
export AI_BASE_URL=""
export AI_API_KEY=""

# ====== Docker 镜像 ======
# worker 起容器时拉的基础镜像
export DOCKER_IMAGE="loongnix-build:23.2"

# ====== engine 行为 ======
# 编译失败最大重试次数
export MAX_RETRIES="4"
# 编译产物（源码 / 产物）落盘目录
export ARTIFACTS_DIR="/root/.openclaw/workspace/compile-platform/artifacts"

# ====== 并发 ======
# worker 线程池大小；同时跑的任务数。
# 服务器 32 物理核，建议每个 worker 限 4 核并发编译
#   8 worker  ×  4 核/worker = 32 核
# 调小会让大编译排队长，调大会让 CPU 抢
export MAX_WORKERS="8"
