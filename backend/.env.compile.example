# 编译 worker / engine 所需的环境变量
# 这是模板文件，提交到 git。
# 实际配置请复制为 .env.compile 并填入真实值，.env.compile 不提交。

# ====== AI 配置 ======
# DeepAgent 调用的 LLM 配置
export AI_MODEL=""
export AI_BASE_URL=""
export AI_API_KEY=""

# 注：worker 编译用的 Docker 镜像不再在这里配
# 改在 admin 端 /admin/systems 管理（DB TargetSystem.base_image 字段）
# 加新系统 / 换镜像 不用改代码不用重启

# ====== engine 行为 ======
# 编译失败最大重试次数
export MAX_RETRIES="4"
# 编译产物（源码 / 产物）落盘目录
# 留空则用代码内推断（仓库根 /artifacts/）。如要自定义路径可填绝对路径。
export ARTIFACTS_DIR=""

# ====== 并发 ======
# worker 线程池大小；同时跑的任务数。
# 服务器 32 物理核，建议每个 worker 限 4 核并发编译
#   8 worker  ×  4 核/worker = 32 核
# 调小会让大编译排队长，调大会让 CPU 抢
export MAX_WORKERS="8"

# ====== stage5 / docker exec 超时 ======
# 教训：ollama cmake --build 全量编要 15+ 分钟，原 10 分钟上限会被强退
# STAGE5_MAX_SECONDS: 整个 stage5 阶段硬上限（秒），含 agent.stream 全过程
# DOCKER_EXEC_TIMEOUT: 单条 docker exec 命令 timeout（秒）
export STAGE5_MAX_SECONDS="1800"
export DOCKER_EXEC_TIMEOUT="3600"

# ALLOW_SELF_REGISTER: 自助注册开关。默认关闭（账号由管理员在用户管理页创建）；
# 设 "1" 重新开放 /auth/register + 登录页注册入口（前端 Login.vue allowSelfRegister 需同步改）
# export ALLOW_SELF_REGISTER="1"
